# ==============================================================================
# QueueLess — Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file or credentials to source control.
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# ==============================================================================
# PART A: MONGODB ATLAS DATABASE CONFIGURATION
# ==============================================================================
# Instructions to get your MongoDB Atlas URI:
# 1. Sign in to https://cloud.mongodb.com
# 2. In your Cluster, click "Connect" -> "Drivers" -> "Node.js"
# 3. Copy the connection string and replace <db_password> with your database user password.
# 4. In "Network Access", ensure your IP (or 0.0.0.0/0 for testing) is allowlisted.
# Example:
# MONGODB_URI=mongodb+srv://queueless_admin:MySecurePass123@cluster0.abcde.mongodb.net/queueless?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=queueless

# ==============================================================================
# PART B: FIREBASE AUTHENTICATION (PHONE SIGN-IN & OTP)
# ==============================================================================
# Instructions to set up Firebase Phone Auth:
# 1. Go to https://console.firebase.google.com and open/create your project.
# 2. Go to "Authentication" -> "Sign-in method" -> Enable "Phone".
# 3. In "Settings" -> "Authorized domains", add your domain (e.g. localhost, 127.0.0.1).
# 4. (Recommended for testing without SMS quota): In "Phone" provider settings,
#    add a test phone number (e.g. +919876543210 with code 123456).
# 5. In "Project Settings" -> "General" -> "Your apps", register a Web App and copy the config:
FIREBASE_CLIENT_API_KEY=AIzaSyBY-MTph6yPrCOD_aOY_P3dXYN_oNuhp30
FIREBASE_AUTH_DOMAIN=queueless-25589.firebaseapp.com
FIREBASE_PROJECT_ID=queueless-25589
FIREBASE_STORAGE_BUCKET=queueless-25589.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=736277318839
FIREBASE_APP_ID=1:736277318839:web:d579d3dc7bb1afcbbed132

# ==============================================================================
# FIREBASE ADMIN SDK (SERVER-SIDE ID TOKEN VERIFICATION - OPTIONAL)
# ==============================================================================
# To verify Firebase ID tokens on the Node.js server:
# Go to "Project Settings" -> "Service accounts" -> "Generate new private key".
# Save the JSON file as "serviceAccountKey.json" in this directory, or set the path:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
